{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "blockedReason", "inspectedFiles", "project", "executiveSummary", "audience", "findings", "claims", "demoPlan", "demoability", "limitations", "editorialContract", "editorialBrief", "visualEvidencePackage", "video"],
  "properties": {
    "status": {"type": "string", "enum": ["completed", "blocked", "failed"]},
    "blockedReason": {"type": "string"},
    "inspectedFiles": {"type": "array", "items": {"type": "string"}},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "versionOrCommit", "license", "primaryLanguage"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string"},
        "versionOrCommit": {"type": "string"},
        "license": {"type": "string"},
        "primaryLanguage": {"type": "string"}
      }
    },
    "executiveSummary": {"type": "string"},
    "audience": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail"],
        "properties": {
          "title": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "confidence", "evidence"],
        "properties": {
          "claim": {"type": "string"},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "detail"],
              "properties": {
                "source": {"type": "string"},
                "detail": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "demoPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "command", "expected", "status"],
        "properties": {
          "step": {"type": "string"},
          "command": {"type": "string"},
          "expected": {"type": "string"},
          "status": {"type": "string", "enum": ["not-run", "passed", "failed", "blocked"]}
        }
      }
    },
    "demoability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "confidence", "reason"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 7},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "editorialContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "name", "digest", "files"],
      "properties": {
        "schemaVersion": {"type": "integer", "enum": [1]},
        "name": {"type": "string", "enum": ["video-production-quality"]},
        "digest": {"type": "string", "minLength": 64, "maxLength": 64},
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string"},
              "digest": {"type": "string", "minLength": 64, "maxLength": 64}
            }
          }
        }
      }
    },
    "editorialBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intendedViewer", "familiarProblem", "oneSentenceAnswer", "titlePromise", "concreteExamples"],
      "properties": {
        "intendedViewer": {"type": "string", "minLength": 1},
        "familiarProblem": {"type": "string", "minLength": 1},
        "oneSentenceAnswer": {"type": "string", "minLength": 1},
        "titlePromise": {"type": "string", "minLength": 1},
        "concreteExamples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["problem", "projectAction", "usefulResult", "claimIndexes"],
            "properties": {
              "problem": {"type": "string", "minLength": 1},
              "projectAction": {"type": "string", "minLength": 1},
              "usefulResult": {"type": "string", "minLength": 1},
              "claimIndexes": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "visualEvidencePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hookMoment", "visualBeats", "demoMoments", "mechanismSteps", "evidenceAssets", "productionMaterials", "contrastMoments"],
      "properties": {
        "hookMoment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose", "narrationCue", "visualMode", "canvas", "shot", "stage", "entrance", "assetIds", "claimIndexes", "leadSeconds", "focalRegion"],
          "properties": {
            "purpose": {"type": "string", "minLength": 1},
            "narrationCue": {"type": "string", "minLength": 1},
            "visualMode": {"$ref": "#/$defs/visualMode"},
            "canvas": {"anyOf": [{"$ref": "#/$defs/visualCanvas"}, {"type": "null"}]},
            "shot": {"anyOf": [{"$ref": "#/$defs/illustrationShot"}, {"type": "null"}]},
            "stage": {"anyOf": [{"$ref": "#/$defs/objectStage"}, {"type": "null"}]},
            "entrance": {"$ref": "#/$defs/beatEntrance"},
            "assetIds": {"$ref": "#/$defs/assetIds"},
            "claimIndexes": {"$ref": "#/$defs/claimIndexes"},
            "leadSeconds": {"type": "number", "minimum": 0, "maximum": 1},
            "focalRegion": {"anyOf": [{"$ref": "#/$defs/focalRegion"}, {"type": "null"}]}
          }
        },
        "visualBeats": {
          "type": "array",
          "minItems": 6,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sectionIndex", "role", "purpose", "narrationCue", "visualMode", "canvas", "shot", "stage", "entrance", "assetIds", "claimIndexes", "durationHint", "leadSeconds", "focalRegion", "stepIndex", "lineNumbers"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"},
              "sectionIndex": {"type": "integer", "minimum": 0, "maximum": 3},
              "role": {"type": "string", "enum": ["show", "prove", "change"]},
              "purpose": {"type": "string", "minLength": 1},
              "narrationCue": {"type": "string", "minLength": 1},
              "visualMode": {"$ref": "#/$defs/visualMode"},
              "canvas": {"anyOf": [{"$ref": "#/$defs/visualCanvas"}, {"type": "null"}]},
              "shot": {"anyOf": [{"$ref": "#/$defs/illustrationShot"}, {"type": "null"}]},
              "stage": {"anyOf": [{"$ref": "#/$defs/objectStage"}, {"type": "null"}]},
              "entrance": {"$ref": "#/$defs/beatEntrance"},
              "assetIds": {"$ref": "#/$defs/assetIds"},
              "claimIndexes": {"$ref": "#/$defs/claimIndexes"},
              "durationHint": {"type": "number", "minimum": 0.5, "maximum": 8},
              "leadSeconds": {"type": "number", "minimum": 0, "maximum": 1},
              "focalRegion": {"anyOf": [{"$ref": "#/$defs/focalRegion"}, {"type": "null"}]},
              "stepIndex": {"type": ["integer", "null"], "minimum": 0},
              "lineNumbers": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 1}}
            }
          }
        },
        "demoMoments": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "demoStepIndexes", "assetIds", "claimIndexes"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"},
              "demoStepIndexes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
              "assetIds": {"$ref": "#/$defs/assetIds"},
              "claimIndexes": {"$ref": "#/$defs/claimIndexes"}
            }
          }
        },
        "mechanismSteps": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "detail", "claimIndexes"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"},
              "label": {"type": "string", "minLength": 1},
              "detail": {"type": "string", "minLength": 1},
              "claimIndexes": {"$ref": "#/$defs/claimIndexes"}
            }
          }
        },
        "evidenceAssets": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "purpose", "mediaType", "licenseBasis", "claimIndexes"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"},
              "path": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1},
              "mediaType": {"type": "string", "enum": ["image", "video"]},
              "licenseBasis": {"type": "string", "minLength": 1},
              "claimIndexes": {"$ref": "#/$defs/claimIndexes"}
            }
          }
        },
        "productionMaterials": {
          "type": "array", "minItems": 0, "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "functionName", "claimIndexes", "mediaInspection", "animationPlan"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"},
              "functionName": {"type": "string", "minLength": 1},
              "claimIndexes": {"$ref": "#/$defs/claimIndexes"},
              "mediaInspection": {
                "type": "object", "additionalProperties": false,
                "required": ["status", "inspected", "selectedAssetIds"],
                "properties": {
                  "status": {"type": "string", "enum": ["usable", "no-suitable-media"]},
                  "inspected": {"type": "array", "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["path", "mediaType", "verdict", "reason", "licenseBasis", "crop", "clip"],
                    "properties": {
                      "path": {"type": "string", "minLength": 1},
                      "mediaType": {"type": "string", "enum": ["image", "video"]},
                      "verdict": {"type": "string", "enum": ["usable", "irrelevant", "unavailable", "license-unclear"]},
                      "reason": {"type": "string", "minLength": 1},
                      "licenseBasis": {"type": "string"},
                      "crop": {"anyOf": [{"$ref": "#/$defs/focalRegion"}, {"type": "null"}]},
                      "clip": {"anyOf": [{"type": "object", "additionalProperties": false,
                        "required": ["startSeconds", "endSeconds"], "properties": {
                          "startSeconds": {"type": "number", "minimum": 0},
                          "endSeconds": {"type": "number", "exclusiveMinimum": 0}
                        }}, {"type": "null"}]}
                    }
                  }},
                  "selectedAssetIds": {"$ref": "#/$defs/assetIds"}
                }
              },
              "animationPlan": {"anyOf": [{"type": "object", "additionalProperties": false,
                "required": ["objects", "actions", "readmeBasis"], "properties": {
                  "objects": {"type": "array", "minItems": 1, "maxItems": 12, "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["id", "kind", "label", "detail"], "properties": {
                      "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
                      "kind": {"type": "string", "enum": ["file", "folder", "window", "review", "search", "code", "comment", "result"]},
                      "label": {"type": "string", "minLength": 1, "maxLength": 24},
                      "detail": {"type": ["string", "null"], "minLength": 1, "maxLength": 90}
                    }
                  }},
                  "actions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["type", "targets"], "properties": {
                      "type": {"type": "string", "enum": ["reveal", "move", "gather", "expand", "scan", "anchor", "morph", "focus"]},
                      "targets": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}}
                    }
                  }},
                  "readmeBasis": {"type": "string", "minLength": 1}
                }}, {"type": "null"}]}
            }
          }
        },
        "contrastMoments": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "before", "after", "claimIndexes"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"},
              "before": {"type": "string", "minLength": 1},
              "after": {"type": "string", "minLength": 1},
              "claimIndexes": {"$ref": "#/$defs/claimIndexes"}
            }
          }
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "fullNarration", "hook", "sections", "closing", "visualAssets"],
      "properties": {
        "title": {"type": "string"},
        "fullNarration": {"type": "string", "minLength": 1},
        "hook": {"type": "string"},
        "sections": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading", "narration", "visual"],
            "properties": {
              "heading": {"type": "string"},
              "narration": {"type": "string"},
              "visual": {"type": "string"}
            }
          }
        },
        "closing": {"type": "string"},
        "visualAssets": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "purpose", "licenseBasis"],
            "properties": {
              "path": {"type": "string"},
              "purpose": {"type": "string"},
              "licenseBasis": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "visualMode": {"type": "string", "enum": ["media-crop", "readme-crop", "progressive-flow", "code-highlight", "compare", "screen-recording", "stat-overlay", "statement", "illustration", "object-action"]},
    "beatEntrance": {"type": "string", "enum": ["fade", "slide-left", "slide-right", "push-in"]},
    "objectStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "links", "action"],
      "properties": {
        "objects": {"type": "array", "minItems": 1, "maxItems": 12, "items": {
          "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "label", "detail", "x", "y", "state"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
            "kind": {"type": "string", "enum": ["file", "folder", "window", "review", "search", "code", "comment", "result"]},
            "label": {"type": "string", "minLength": 1, "maxLength": 24},
            "detail": {"type": ["string", "null"], "minLength": 1, "maxLength": 90},
            "x": {"type": "number", "minimum": 0.08, "maximum": 0.92},
            "y": {"type": "number", "minimum": 0.12, "maximum": 0.88},
            "state": {"type": "string", "enum": ["idle", "active", "done"]}
          }
        }},
        "links": {"type": "array", "maxItems": 12, "items": {
          "type": "object", "additionalProperties": false, "required": ["from", "to"],
          "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
        }},
        "action": {
          "type": "object", "additionalProperties": false, "required": ["type", "targets"],
          "properties": {
            "type": {"type": "string", "enum": ["reveal", "move", "gather", "expand", "scan", "anchor", "morph", "focus"]},
            "targets": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}}
          }
        }
      }
    },
    "illustrationShot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "before", "action", "result", "focus", "negateBefore"],
      "properties": {
        "kind": {"type": "string", "enum": ["browser", "comparison", "question"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 48},
        "before": {"type": "string", "minLength": 1, "maxLength": 80},
        "action": {"type": "string", "minLength": 1, "maxLength": 80},
        "result": {"type": "string", "minLength": 1, "maxLength": 80},
        "focus": {"type": "string", "enum": ["before", "action", "result"]},
        "negateBefore": {"type": "boolean"}
      }
    },
    "visualCanvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "focusId"],
      "properties": {
        "nodes": {"type": "array", "minItems": 1, "maxItems": 5, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "label", "kind"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
            "label": {"type": "string", "minLength": 1, "maxLength": 18},
            "kind": {"type": "string", "enum": ["input", "action", "result", "note"]}
          }
        }},
        "edges": {"type": "array", "maxItems": 4, "items": {
          "type": "object", "additionalProperties": false, "required": ["from", "to"],
          "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
        }},
        "focusId": {"type": ["string", "null"]}
      }
    },
    "assetIds": {"type": "array", "items": {"type": "string"}},
    "claimIndexes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "focalRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    }
  }
}
