# Optional. Authenticated requests have a higher GitHub API rate limit.
GITHUB_TOKEN=

# Optional. Only set these when this machine requires an HTTP proxy.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

# auto tries the preferred elevated Windows sandbox, then falls back to
# unelevated for read-only research only. Run-enabled research never auto-falls back.
CODEX_WINDOWS_SANDBOX=

# Required by video:prepare. Use qwen for the registered remote voice clone.
# Set windows only when intentionally using the legacy local fallback.
VIDEO_TTS_PROVIDER=
QWEN_TTS_BASE_URL=http://127.0.0.1:8000
QWEN_TTS_API_KEY=
QWEN_TTS_VOICE_ID=
QWEN_TTS_LANGUAGE=Chinese
# QWEN_TTS_TIMEOUT_MS=1200000
# Set a seed to send the same explicit sampling policy with every block in one episode.
# QWEN_TTS_SEED=20260918
# QWEN_TTS_DO_SAMPLE=true
# QWEN_TTS_TOP_K=50
# QWEN_TTS_TOP_P=1
# QWEN_TTS_TEMPERATURE=0.8
# QWEN_TTS_REPETITION_PENALTY=1.05
# QWEN_TTS_SUBTALKER_DO_SAMPLE=true
# QWEN_TTS_SUBTALKER_TOP_K=50
# QWEN_TTS_SUBTALKER_TOP_P=1
# QWEN_TTS_SUBTALKER_TEMPERATURE=0.8
# The remote /health endpoint must report MAX_NEW_TOKENS=1024 or higher.
# Automatically creates a temporary, non-interactive SSH tunnel when Qwen is not reachable.
QWEN_TTS_AUTO_TUNNEL=true
QWEN_TTS_SSH_HOST=
QWEN_TTS_SSH_USER=
QWEN_TTS_SSH_KEY=
# QWEN_TTS_SSH_PORT=22
# QWEN_TTS_REMOTE_HOST=127.0.0.1
# QWEN_TTS_REMOTE_PORT=8000
# QWEN_TTS_TUNNEL_START_TIMEOUT_MS=20000
# WINDOWS_TTS_VOICE=Microsoft Huihui Desktop
# WINDOWS_TTS_RATE=1
