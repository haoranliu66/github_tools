# Optional. Authenticated requests have a higher GitHub API rate limit.
GITHUB_TOKEN=

# Optional. Only set these when this machine requires an HTTP proxy.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

# auto tries the preferred elevated Windows sandbox, then falls back to
# unelevated for read-only research only. Run-enabled research never auto-falls back.
CODEX_WINDOWS_SANDBOX=

# Required by video:prepare. Use qwen for the registered remote voice clone.
# Set windows only when intentionally using the legacy local fallback.
VIDEO_TTS_PROVIDER=
QWEN_TTS_BASE_URL=http://127.0.0.1:8000
QWEN_TTS_API_KEY=
QWEN_TTS_VOICE_ID=
QWEN_TTS_LANGUAGE=Chinese
# QWEN_TTS_TIMEOUT_MS=1200000
# WINDOWS_TTS_VOICE=Microsoft Huihui Desktop
# WINDOWS_TTS_RATE=1
